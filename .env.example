# Copy to .env.local for local development. Every variable the project needs is
# listed here — a future owner should be able to stand this up from this file
# alone, without contacting the original maintainer (R22).

# --- Database ---------------------------------------------------------------
# Postgres connection string. Use a POOLED url in production (Vercel functions
# are serverless and will exhaust a direct connection limit).
# Local development (Homebrew): brew install postgresql@17 && brew services start postgresql@17
# then: createdb dnj_dev && createdb dnj_test
# The default Homebrew superuser is your macOS username with no password.
DATABASE_URL="postgresql://YOUR_USERNAME@127.0.0.1:5432/dnj_dev"

# Separate database used by `pnpm test`. Integration tests truncate tables, so
# this must NOT point at a database holding real content. The suite refuses to
# run if this is unset or equal to DATABASE_URL.
TEST_DATABASE_URL="postgresql://YOUR_USERNAME@127.0.0.1:5432/dnj_test"

# --- Auth -------------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public origin of the deployment, no trailing slash.
BETTER_AUTH_URL="http://localhost:3000"

# Credentials for the one admin account, consumed ONLY by `npm run seed:admin`.
# There is no public registration route; this script is the only way an account
# comes into existence (R13).
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Site maintainer"

# --- Image storage ----------------------------------------------------------
# Vercel Blob read/write token. Created under the Vercel project's Storage tab.
# When unset, uploads fall back to the local filesystem under ./public/uploads,
# which is fine for development and never used in production.
BLOB_READ_WRITE_TOKEN=""

# --- Site identity (R8, R12) ------------------------------------------------
# The center is in one place, so the site has one clock. Every displayed time
# and all recurrence stepping happens in this zone — set it to the center's
# actual timezone before launch, or a weekly 6pm program will drift.
#
# Must be a full IANA name. Leaving it unset or blank falls back to
# America/New_York; an unrecognized name fails the build by name rather than
# publishing a calendar showing the wrong hour. Avoid abbreviations like EST —
# the runtime accepts them, but they have no daylight saving and drift by an
# hour for half the year.
NEXT_PUBLIC_SITE_TIME_ZONE="America/New_York"

# These render in the shared layout on every public page.
NEXT_PUBLIC_CENTER_NAME="Dorothy N. Johnson Community Center"
NEXT_PUBLIC_CENTER_ADDRESS=""
NEXT_PUBLIC_CENTER_HOURS=""
# The official city / parks page this site links out to and defers to.
NEXT_PUBLIC_OFFICIAL_URL=""

# Browser tests get their own database — they publish real events.
E2E_DATABASE_URL="postgresql://YOUR_USERNAME@127.0.0.1:5432/dnj_e2e"
